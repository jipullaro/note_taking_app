# Copy this file to .env and fill in real secrets before running
# `docker compose up`.

# --- Postgres ---
# A managed provider hands out a single DATABASE_URL instead of these five,
# and it wins when set (see config/settings/base.py). That's the form Vercel
# marketplace integrations inject; compose uses the POSTGRES_* variables.
# DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=require
POSTGRES_DB=notes
POSTGRES_USER=notes
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Django ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
# Local only. Do NOT set this on Vercel: every entrypoint already defaults to
# config.settings.prod there, and pointing it back at dev is refused outright.
DJANGO_SETTINGS_MODULE=config.settings.dev
SIMPLE_JWT_ACCESS_MINUTES=30
SIMPLE_JWT_REFRESH_DAYS=7

# --- Archive retention / Celery ---
# Broker for the worker and beat. "redis" is the compose service name, so
# this only resolves inside the docker network; use localhost:6379 when
# running a worker on the host.
CELERY_BROKER_URL=redis://redis:6379/0
# How long a note stays in the archive before it's deleted for good.
NOTE_ARCHIVE_RETENTION_DAYS=1
# How often beat asks the worker to run the purge. Drop this to 1 to watch
# it fire while developing. Vercel has no beat process — there the schedule
# is the `crons` entry in backend/vercel.json, so change both together.
NOTE_PURGE_INTERVAL_MINUTES=60
# Shared secret for the purge cron endpoint. Only used on Vercel, which sets
# it for you once you add a CRON_SECRET env var and sends it as
# `Authorization: Bearer <secret>`. Unset, the endpoint refuses every request.
# CRON_SECRET=

# --- Next.js ---
# Used server-side (by Server Components and the /api/proxy + /api/auth
# route handlers) to reach Django from inside the docker network.
BACKEND_INTERNAL_URL=http://backend:8000
NODE_ENV=development
